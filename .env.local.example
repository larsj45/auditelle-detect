# =============================================================================
# Auditelle Detect — local environment template
# Copy to `.env.local` for local smoke tests. Never commit real secrets.
# =============================================================================

# Brand / app
RESELLER_ID=auditelle-fr
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local smoke tests only
# Set to 1 to return deterministic Pangram-like responses without a real API key.
# Do not enable this in production or preview environments.
PANGRAM_MOCK_RESPONSES=1

# Pangram Labs API
# Required when PANGRAM_MOCK_RESPONSES is not enabled.
PANGRAM_API_KEY=
# Explicit selector for the current async inference API.
PANGRAM_MODEL=pangram-4

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe core
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe subscription prices
STRIPE_STUDENT_PRICE_ID=price_your_student_price_id
STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_UNIVERSITY_PRICE_ID=price_your_university_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# Scheduled jobs / admin endpoints
CRON_SECRET=local_cron_secret_placeholder
SLACK_WEBHOOK_URL=

# Email
RESEND_API_KEY=

# SSO
SSO_SECRET=
